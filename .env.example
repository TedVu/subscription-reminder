# Copy to .env.local and fill in from Supabase dashboard > the project page > Copy (Project URL, Publishable key).
# Only the publishable key belongs here — never the secret key (sb_secret_...).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
